-- readFrame：energy-mode 捕获契约（tests/test_energy_mode.py）——存在 withScreen 时
-- 由它包裹执行（截图帧环境），否则直接执行；返回值原样传递。
local function readFrame(body)
 if type(withScreen)=='function' then return withScreen(body) end
 return body()
end
local function run(name)
 local output={};local realLog=log
 log=function(s) output[#output+1]=tostring(s);realLog(s) end
 local ok,result=pcall(function() return readFrame(parts[name]) end);log=realLog
 if not ok then error(result) end
 return table.concat(output,'\n')
end
