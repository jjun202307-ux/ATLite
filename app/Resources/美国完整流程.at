  for _,b in ipairs(ocrText()) do
   local t=(b.text or ''):lower()
   if t:find('send you notifications',1,true) or t:find('would like to send',1,true) then
    for _,c in ipairs(ocrText()) do
     local u=(c.text or ''):lower()
     if (u:find("don't allow",1,true) or u:find('don’t allow',1,true)) and not deny then deny=c end
    end
    break
   end
  end
  if not deny then return end
  tap(deny.x+(deny.width or 0)/2,deny.y+(deny.height or 0)/2)
  msleep(1000)
  log('DISMISSED_NOTIFY_DIALOG')
 end
