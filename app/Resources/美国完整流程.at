-- 接码模块（2026-11-06 重构版 v2，纯 Lua，移植自电脑版 eagle_vinted.air/icloud_code.py 实证方案）
-- 链路：at.httpGet 取信 → 提取 iframe srcdoc 邮件正文 → 可见文本 → 语境取码 → 基线判新
--       → phoneFlow('commit_code') 提交（原生 Registration 状态机）→ 原生输入。
-- 设计要点（与电脑版一致）：
--  1. 邮件正文在 iframe srcdoc（实体转义），先取 srcdoc 再剥标签，外层 CSS 颜色（#172033 等）不干扰；
--  2. 可见文本排除 script/style/noscript/head，块级标签换行；
--  3. 取码：语境后 100 非数字字符内的边界完整 4/6 位数字；失败再试"独立成行"版式；唯一候选才收；
--  4. 基线：首轮正文文本整体作基线（等效电脑版 sha256 指纹），新邮件=正文不同；
--  5. 每轮日志区分：无新邮件 / 新邮件未识别 / 网络错误可重试，不再黑盒。

local M={}

-- HTML 实体解码
local function decodeEntities(s)
  if not s then return '' end
  local map={['&lt;']='<',['&gt;']='>',['&quot;']='"',['&#39;']="'",['&#160;']=' ',['&nbsp;']=' ',['&amp;']='&'}
  for a,b in pairs(map) do s=s:gsub(a,b) end
  return s
end

-- 提取 WDMail iframe srcdoc 中的完整邮件正文（实体转义，无双引号冲突）
local function extractSrcdocHtml(page)
  local i=page:find('<iframe',1,true)
  while i do
    local tagEnd=page:find('>',i+8)
    if not tagEnd then break end
    local open=page:sub(i,tagEnd)
    local q,content=open:match("srcdoc%s*=%s*(['\"])(.-)%1")
    if content and #content>0 then return decodeEntities(content) end
    i=page:find('<iframe',tagEnd+1,true)
  end
  return nil
end

-- 可见文本：排除 script/style/noscript/head，块级标签转换行，剥其余标签，逐行压缩空白
local function visibleText(html)
  local s=html
  s=s:gsub('<(script%f[^%w])[^>]*>.-</script>',' ')
  s=s:gsub('<(style%f[^%w])[^>]*>.-</style>',' ')
  s=s:gsub('<(noscript%f[^%w])[^>]*>.-</noscript>',' ')
  s=s:gsub('<head[^>]*>.-</head>',' ')
  s=s:gsub('<%s*(/?)%s*(%a+)[^>]*>',function(slash,tag)
    if tag=='p' or tag=='div' or tag=='br' or tag=='tr' or tag=='td' or tag=='h1' or tag=='h2' or tag=='li' or tag=='article' or tag=='section' then return '\n' end
    return ' '
  end)
  s=s:gsub('<[^>]*>',' ')
  s=decodeEntities(s)
  local lines={}
  for raw in (s..'\n'):gmatch('(.-)\n') do
    local line=raw:gsub('%s+',' '):gsub('^%s+',''):gsub('%s+$','')
    if #line>0 then lines[#lines+1]=line end
  end
  return table.concat(lines,'\n')
end

-- 邮件正文文本：优先 srcdoc，否则整页（防接口改版兜底）
local function emailText(page)
  local srcdoc=extractSrcdocHtml(page)
  local body=srcdoc or page
  local text=visibleText(body)
  -- 去掉接口包装层前缀（"邮件内容："之前的接收时间/主题）
  local a=text:find('邮件内容%s*[:：]')
  if a then text=text:sub(a) end
  return text
end

-- 语境词表（中/英/法，与电脑版一致）
local cues={'验证码','验证代码','校验码',
  'verification code','security code','confirmation code','code below','your code',
  'code de vérification','code de verification','code de confirmation',
  'code de sécurité','code de securité','code ci%-dessous','votre code'}

-- 边界完整的 4/6 位数字校验
local function boundaryOk(text,s1,e1)
  local before=text:sub(s1-1,s1-1)
  local after=text:sub(e1+1,e1+1)
  local after2=text:sub(e1+2,e1+2)
  if before:match('[%w_]') then return false end
  if after:match('[%w_]') then return false end
  if (after=='-' or after=='/' or after==':') and after2:match('[0-9]') then return false end
  return true
end

-- 取码：主匹配（语境后 100 字符内）→ 独立成行兜底 → 唯一候选才返回
-- 返回 code|nil, detail('primary'|'line'|'none'|'ambiguous')
function M.extractCode(text)
  if type(text)~='string' or #text==0 then return nil,'none' end
  local lower=text:lower()
  local hasCue=false
  for _,cue in ipairs(cues) do
    if lower:find(cue,1,false) then hasCue=true break end
  end
  -- 无语境词不直接放弃：独立成行版式仍是强信号（纯文本邮件无 cue 词时靠它）
  local found={}
  -- 主匹配：逐语境位置，取其后 100 字符内第一个边界完整 4/6 位数字
  for _,cue in ipairs(cues) do
    local start=1
    while true do
      local a,b=lower:find(cue,start)
      if not a then break end
      local window=text:sub(b+1,b+101)
      for s1,e1,digits in window:gmatch('()()(%d%d%d%d%d?%d?)') do
        if (#digits==4 or #digits==6) and boundaryOk(window,s1,e1) then
          found[digits]=true
        end
        break -- 每语境实例只取其后第一个数字
      end
      start=b+1
    end
  end
  local list={}
  for code in pairs(found) do list[#list+1]=code end
  if #list==1 then return list[1],'primary' end
  if #list>1 then return nil,'ambiguous' end
  -- 兜底：独立成行版式（CSS 颜色、URL、日期不会独立成行）
  found={}
  for line in (text..'\n'):gmatch('(.-)\n') do
    local code=line:match('^%s*([0-9][0-9][0-9][0-9][0-9]?[0-9]?)%s*$')
    if code and (#code==4 or #code==6) then found[code]=true end
  end
  list={}
  for code in pairs(found) do list[#list+1]=code end
  if #list==1 then return list[1],'line' end
  if #list>1 then return nil,'ambiguous' end
  return nil,'none'
end

-- 判新：滤掉基线码后唯一非基线候选即收（比电脑版增强：旧码在邮箱里也能收新码）
function M.decideCode(text,baselineCodes)
  if type(text)~='string' or #text==0 then return nil,'empty' end
  local lower=text:lower()
  local found={}
  for _,cue in ipairs(cues) do
    local start=1
    while true do
      local a,b=lower:find(cue,start)
      if not a then break end
      local window=text:sub(b+1,b+101)
      for s1,e1,digits in window:gmatch('()()(%d%d%d%d%d?%d?)') do
        if (#digits==4 or #digits==6) and boundaryOk(window,s1,e1) then found[digits]=true end
        break
      end
      start=b+1
    end
  end
  if not next(found) then
    for raw in (text..'\n'):gmatch('(.-)\n') do
      local code=raw:match('^%s*([0-9][0-9][0-9][0-9][0-9]?[0-9]?)%s*$')
      if code and (#code==4 or #code==6) then found[code]=true end
    end
  end
  local fresh={}
  for code in pairs(found) do
    if not baselineCodes[code] then fresh[#fresh+1]=code end
  end
  if #fresh==1 then return fresh[1],'ok' end
  if #fresh==0 then return nil,'baseline' end
  table.sort(fresh)
  return nil,'ambiguous:'..table.concat(fresh,',')
end

function M.mask(code)
  if type(code)~='string' or #code<2 then return tostring(code) end
  return code:sub(1,2)..'****'
end

function M.init(url)
  if type(url)~='string' or not url:find('^https?://') or not url:find('e=',1,true) then
    return nil,'取信链接不是有效HTTP/HTTPS地址或缺少 e= 邮箱参数'
  end
  return {url=url,baselineText=nil,baselineCodes=nil,rounds=0}
end

-- 取信（每轮日志：字节；沙箱无 os/time，耗时不计——原生 httpGet 自带 12s 超时）
function M.fetch(state)
  state.rounds=state.rounds+1
  local body,err=at.httpGet(state.url)
  if not body then
    log(string.format('接码 第%d轮 fetch失败 %s',state.rounds,tostring(err)))
    return nil,tostring(err)
  end
  log(string.format('接码 第%d轮 fetch ok bytes=%d',state.rounds,#body))
  return body
end

-- 单轮：取信→正文→判新。
-- 返回 'new',code | 'same' | 'unparsed' | nil,err
function M.poll(state)
  local body,err=M.fetch(state)
  if not body then return nil,err end
  local text=emailText(body)
  if state.baselineText==nil then
    state.baselineText=text
    state.baselineCodes={}
    local code,detail=M.extractCode(text)
    if code then state.baselineCodes[code]=true end
    log(string.format('接码 基线已建 正文=%d字节 基线码=%s',#text,code and M.mask(code) or '无'))
    return 'same'
  end
  if text==state.baselineText then return 'same' end
  local code,detail=M.decideCode(text,state.baselineCodes)
  if code then
    log(string.format('接码 第%d轮 新邮件判新成功 %s(%s)',state.rounds,M.mask(code),detail))
    return 'new',code
  end
  log(string.format('接码 第%d轮 新邮件但未识别唯一新码 %s',state.rounds,tostring(detail)))
  return 'unparsed'
end
local mailState=nil -- 接码模块状态表（模块表=M，状态表=mailState，两者绝不混用）
local function waitCode(email)
 -- 等码上限见下方 for round=1,150（5分钟）：超时判本账号失败换号。
 -- 恢复本阶段时屏幕可能停在ATLite等前台，先把Vinted拉回前台再观察，避免对错误页面空转。
 dismissSystemDialogs()
 local ok,err=pcall(openApp,'Vinted','vinted')
 if ok then log('已切回Vinted，开始观察接码页面') else log('未能自动切回Vinted（'..tostring(err)..'），按当前屏幕观察') end
 -- 2026-11-05 用户规则：等验证码最多5分钟（150轮×2秒），超时判本账号失败换下一个，禁止无限卡死任务。
 -- 2026-11-06 用户规则：人机验证不停不等人工——连续2轮确认后自动跑滑块（内部3次×15秒），
 -- 滑块通过则继续接码；仍过不去则 SLIDER_FAILED 记本账号失败领下一个（同填表阶段 HUMAN_VERIFY_SEEN 语义）。
 -- 2026-11-06 接码重构：取信+解析+判新全在 Lua 模块（M.init/M.poll，每轮日志），
 -- 判新成功→phoneFlow('commit_code',码)写入原生状态机→verify 原生输入提交（替代旧 phoneFlow('mail') 黑盒，全程可查）。
 -- 基线原则：正常路径在 prepare_account 阶段（提交前）已建；恢复路径这里首轮现建。
 -- 恢复路径风险：若验证码在基线建立前已到邮箱，会被判基线码滤掉直至超时（与旧原生基线快照语义一致，已记录）。
 local url='https://api.wdmail.top/m?f=html&e='..tostring(email or '')
 -- mailState.url 比对：多账号连续运行时状态残留指向上一邮箱时必须重建（模块表 M 永不被重指向）
 if type(mailState)~='table' or mailState.url~=url then
  mailState,err=M.init(url)
  if not mailState then log('接码模块初始化失败：'..tostring(err));error('MAIL_INIT_FAILED_STOP') end
  M.poll(mailState)
 end
 local humanRounds=0
 local stateAdvanced=false
 for round=1,150 do
  dismissSystemDialogs()
  local page=run('observe')
  if has(page,'PAGE_ACCOUNT_BLOCKED') then error('ACCOUNT_BLOCKED_RESULT') end
  if has(page,'PAGE_BLOCKED') then error('SERVER_BLOCKED_STOP') end
  if has(page,'PAGE_PHONE_VERIFICATION') then phoneFlow('sms');return end
  if has(page,'PAGE_HUMAN_VERIFICATION') then
   humanRounds=humanRounds+1
   if humanRounds>=2 then
    log('检测到人机验证，尝试自动过滑块')
    if passWelcomeSlider() and not has(run('observe'),'PAGE_HUMAN_VERIFICATION') then
     log('滑块已通过，继续接码')
     humanRounds=0
    else
     error('SLIDER_FAILED')
    end
   end
  else humanRounds=0 end
  if has(page,'PAGE_UNKNOWN') then
   local sample={}
   for _,b in ipairs(ocrText()) do local t=(b.text or ''):gsub('%s+',' ');if #t>0 then sample[#sample+1]=t end end
   local diag='UNKNOWN_PAGE_DIAG screen='..screenWidth()..'x'..screenHeight()..' colors='..getColor(207,222)..','..getColor(207,470)..','..getColor(207,800)..' ocr='..table.concat(sample,' | ')
   log(diag:sub(1,500))
   log('未知页面，本账号失败换下一个')
   error('UNKNOWN_PAGE_STOP')
  end
  -- 新接码模块轮询：fetch+判新，状态分 new/same/unparsed/nil+err，日志在模块内（fetch 字节/基线/判定）
  local mailStatus,mailCode=M.poll(mailState)
  if mailStatus=='new' then
   log('接码判新成功，写入原生状态机 code='..M.mask(mailCode))
   local okc,errc=pcall(phoneFlow,'commit_code',mailCode)
   if not okc then log('commit_code失败：'..tostring(errc)) end
   if okc and has(page,'PAGE_EMAIL_CODE') then local result=run('verify');if has(result,'REG_SMS_REQUIRED') then phoneFlow('sms') end;return end
  end
  -- 2026-11-06 修复：fill 见到人机验证时走滑块分支返回，没记 verification_seen，
  -- 任务停在 submitting，commit_code 会拒（要求 wait_code），码在邮箱也永远取不到。
  -- 已在验证码页而任务未进 wait_code/code_ready 时，补记 verification_seen（submitting→wait_code），每账号仅试一次。
  if not stateAdvanced and has(page,'PAGE_EMAIL_CODE') then
   local pfOk,pfState=pcall(phoneFlow,'status')
   if pfOk and pfState.state~='wait_code' and pfState.state~='code_ready' then
    stateAdvanced=true
    local oka=pcall(registrationStage,'verification_seen')
    log('补记verification_seen：'..tostring(oka))
   end
  end
  msleep(2000)
 end
 error('CODE_WAIT_TIMEOUT_STOP')
end
-- 2026-11-05 实证：screenWidth/screenHeight 走 SpringBoard 主队列分发，主线程忙时
-- 1.5s 超时返回 0，单次判死会在 11:14 那样误杀整个脚本（PHONE_SIZE_MISMATCH 假阳性）。重试 10 次。
do
 local sizeOk=false
 for i=1,10 do
  if screenWidth()==414 and screenHeight()==896 then sizeOk=true;break end
  msleep(500)
 end
 if not sizeOk then error('PHONE_SIZE_MISMATCH') end
end
-- 连续运行（2026-11-05 用户规则）：单账号失败不停止。失败后经工作台标记失败后
-- 自动领取下一个账号，一直跑到工作台没有可领取账号为止。
-- 初始 nil 哨兵：邮箱为空的重复返回（管理器无新账号）也要能终结循环，
-- 否则单账号完成后会在轮询底 msleep 上空转（tests/test_phone_flow.py 无 UI 副作用契约）。
local previousEmail=nil
local function runOneAccount()
log('正在读取启动账号和最新状态；工作台模式请保持电脑管理器在线')
local state=phoneFlow('begin')
log('启动账号已确认，从保存的正确阶段继续')
local email=state.email or ''
currentEmail=email
if previousEmail~=nil and email==previousEmail then log('没有新账号，结束循环');return 'ended' end
previousEmail=email
if state.state=='blocked' then phoneFlow('blocked');log('服务端阻止本账号，已记录，进入下一个账号');return 'completed' end
if state.state=='sms_pending' then phoneFlow('sms');log('已补写短信验证结果，本轮完成');return 'completed' end
if state.state=='done' or state.state=='sms_required' then log('该账号已经完成，不会重复注册');return 'completed' end
if state.job~='' and state.next>11 then
 local job=phoneFlow('job_status')
 if job.state=='done' then phoneFlow('finish');log('已恢复完成记录');return 'completed' end
 if job.state=='review' then
  local page=run('observe')
  if not has(page,'PAGE_EMAIL_CODE') then log('结果待核对，不能重新提交，进入下一个账号');return 'completed' end
  state=phoneFlow('resume_mail')
 end
end
local stages={
 {'卸载Vinted',function() if installed() then run('US_准备_卸载Vinted');if installed() then error('UNINSTALL_FAILED') end end end},
 {'第一次Safari清理',safari},
 {'关闭小火箭',function() openApp('Shadowrocket','shadowrocket');run('proxy_off');parts['US_准备_节点轮转']() end},
 {'第一次AMG',amg},
 {'关闭后台',function() run('close_apps') end},
 {'安装Vinted',function()
  if installed() then return end
  openApp('App Store','appstore');run('US_准备_AppStore安装')
-- 2026-11-05 用户规则：等"OPEN"最多5分钟（75轮×4秒），超时判本账号失败换下一个，禁止无限卡死任务。
  for i=1,75 do local h=findText('OPEN');if h and #h>0 then return end;msleep(4000) end
  error('INSTALL_WAIT_TIMEOUT_STOP')
 end},
 {'第二次AMG',amg},
 {'第二次Safari清理',safari},
 {'开启小火箭',proxyOn},
 -- 注册前最后一次 AMG：只有这一次读页面底部 IP，日志带账号邮箱。
 {'第三次AMG',function() amg();pcall(run,'US_准备_AMG读IP') end},
 {'打开注册页',openForm},
 {'领取本机账号和读取旧邮件基线',function()
  phoneFlow('prepare_account')
  -- 2026-11-06 接码模块基线快照（提交前）：防止验证码先于基线到达邮箱被当旧码滤掉死等。
  -- 初始化失败=配置缺失，missing config 致命上抛（外层契约：换号重试无意义）。
  local url='https://api.wdmail.top/m?f=html&e='..tostring(email or '')
  -- 注意：模块表是 M，状态表是 mailState，绝不把 M 重指向状态（否则 M.init/M.poll 被冲掉）
  local ms,merr=M.init(url)
  if not ms then log('接码模块初始化失败：'..tostring(merr));error('missing config: 接码取信链接初始化失败 '..tostring(merr)) end
  mailState=ms
  M.poll(mailState)
 end},
 {'填写并单次提交',function()
  local fillResult=run('fill')
  -- 点 Continue 后见到 human/verify：给欢迎滑块机会（3次、每次15秒，见 US_滑块.at）。
  -- 3次用尽仍过不了 = 本账号失败，直接领下一个账号（脚本规则，不停不等人工）。
  if has(fillResult,'HUMAN_VERIFY_SEEN') then
   if passWelcomeSlider() then log('欢迎滑块已通过');return end
   error('SLIDER_FAILED')
  end
  -- 2026-11-06 用户规则：注册后直接出现"Add a phone number"页=需要接短信码，
  -- 不是失败：标注 sms_required 状态（phoneFlow('sms')）并直接领下一个账号。
  if has(fillResult,'REG_SMS_REQUIRED') then phoneFlow('sms');log('需要接短信码，本轮完成并已保存');return end
  if passWelcomeSlider() then log('欢迎滑块已通过') end
 end},
 {'接码和注册后续页面',function() waitCode(email) end},
}
for index=state.next+1,#stages do
 local item=stages[index]
 for attempt=1,3 do
  local checkpoint=phoneFlow('status');if checkpoint.retry_ms>0 then msleep(checkpoint.retry_ms) end
  phoneFlow('stage_begin',index-1);log('阶段开始：'..item[1])
  local ok,problem=pcall(item[2])
  if ok then local current=phoneFlow('status');if current.state=='sms_required' then log('需要接短信码，本轮完成并已保存');return end;phoneFlow('stage_done',index-1);log('阶段完成：'..item[1]);break end
  local message=tostring(problem)
  if has(message,'SERVER_BLOCKED_STOP') then phoneFlow('blocked');log('服务端阻止本账号，已记录，进入下一个账号');return 'completed' end
  if has(message,'SMS_REQUIRED') then phoneFlow('sms');log('需要接短信码，本轮完成并已保存');return 'completed' end
  if index>=13 or has(message,'_STOP') then error(message) end
  phoneFlow('stage_failed',index-1)
  if attempt>=3 then error(message) end
  log('当前步骤15秒后重试：'..item[1]);msleep(15000)
 end
end
phoneFlow('finish');log('手机完整流程完成，结果已保存到results.txt');return 'completed'
end
-- 外层保护：单账号错误统一标记失败并进入下一个，全程全自动、不停不等人工
-- （2026-11-06 用户规则：删除全部 _PAUSE 人工暂停；未知页面=本账号失败换下一个）。
-- 注意：滑块3次不过是 SLIDER_FAILED → 正常记失败领下一个账号（脚本规则）。
local MAX_CONSECUTIVE_FAILURES=10
local consecutiveFailures=0
while true do
 local ok,result=pcall(runOneAccount)
 if not ok then
  local message=tostring(result)
  if message:find('工作台没有可领取的未处理账号',1,true) then log('工作台没有可领取的账号，结束循环');break end
  -- 配置缺失是致命错误：换号重试无意义，直接上抛（tests/test_phone_flow.py 契约：missing config 必须原样冒出）。
  if message:find('missing config',1,true) then error(message) end
  consecutiveFailures=consecutiveFailures+1
  log('本账号失败（连续第'..consecutiveFailures..'个）：'..message)
  -- 2026-11-05 修复：本地注册任务是一次性占用（getRegistrationJob 同进程二次领取即报错
  -- "already claimed"）。工作台模式下失败的账号不走 verification_seen/success 分支，
  -- 占用不释放会杀死下一个账号的填表。这里统一释放（无占用时 pcall 静默失败）。
  local okr=pcall(registrationStage,'failed');if okr then log('已释放本地注册任务占用') end
  if message:find('ACCOUNT_BLOCKED_RESULT',1,true) then local okb=pcall(phoneFlow,'blocked');if okb then log('已向工作台上报封号') end end
 else
  consecutiveFailures=0
  if result=='ended' then log('没有新账号，结束循环');break end
 end
 if consecutiveFailures>=MAX_CONSECUTIVE_FAILURES then error('连续'..MAX_CONSECUTIVE_FAILURES..'个账号失败，暂停等待人工检查（排除问题后可再次运行）') end
 -- 仅失败后才等待15秒再取下一个；成功则立即继续（无 UI 副作用契约，见 tests/test_phone_flow.py）
 if consecutiveFailures>0 then log('等待15秒后处理下一个账号');msleep(15000) end
end
log('本次运行结束')
