  openApp('App Store','appstore');run('US_准备_AppStore安装')
  for i=1,40 do local h=findText('OPEN');if h and #h>0 then return end;msleep(4000) end
  error('INSTALL_TIMEOUT')
 end},
 {'第二次AMG',amg},
 {'第二次Safari清理',safari},
