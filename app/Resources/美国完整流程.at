-- 纯手机入口：无需电脑、USB或SSH。由generate_phone_flow.py生成。
local parts={}
-- 2026-11-07：当前账号邮箱，供「第三次AMG」读IP日志按账号精确归因。
local currentEmail=''
parts['US_准备_AMG_定位']=function()
-- 仅识别 AMG 菜单；不触发“原始机器”或“一键新机”。
if screenWidth()~=414 or screenHeight()~=896 then error('屏幕尺寸与模板不匹配') end
local function findOne(name,region)
    local hits=findImage(name,0.75,region)
    if not hits or #hits~=1 then error('AMG 模板没有唯一结果：'..name) end
    return hits[1]
end
local new=findOne('PHONE_amg_new.png',{x=0,y=285,width=120,height=55})
local original=findOne('PHONE_amg_original.png',{x=0,y=330,width=120,height=55})
if math.abs(new[1]-original[1])>15 or original[2]-new[2]<30 or original[2]-new[2]>60 then
    error('AMG 菜单布局不匹配')
end
log('AMG_MENU_CONFIRMED',new[1],new[2],new[3],original[1],original[2],original[3])

end
parts['US_准备_AMG执行_开发中']=function()
-- 需要由调度器先打开 AMG；每次调用执行一轮，不在结果不明时重试。
if screenWidth()~=414 or screenHeight()~=896 then error('设备尺寸不匹配') end
local function locate(name,area)
    local hits=findImage('PHONE_amg_'..name..'.png',0.75,area)
    if not hits or #hits~=1 then error('AMG 菜单未确认：'..name) end
    return hits[1]
end
-- AMG 会保留上次子页面；先通过左上角返回按钮恢复主菜单。
local menu=findImage('PHONE_amg_original.png',0.75,{x=0,y=330,width=120,height=55})
if not menu or #menu==0 then
    local back=findText('AMG')
    for _,p in ipairs(back or {}) do
        if p[1]<100 and p[2]<100 then tap(p[1],p[2]);msleep(600);break end
    end
end
local original=locate('original',{x=0,y=330,width=120,height=55})
local new=locate('new',{x=0,y=285,width=120,height=55})
if original[2]<=new[2] or math.abs(original[1]-new[1])>15 then error('AMG 菜单布局不符') end
tap(original[1],original[2]);msleep(1200)
new=locate('new',{x=0,y=285,width=120,height=55})
tap(new[1],new[2])
log('AMG_ACTION_SENT')

end
parts['US_准备_AMG监测_开发中']=function()
-- AMG_BUSY_SEEN 由调度器传入；每次只观察，不再次点击。
local absent=0
local result=nil
for i=1,25 do
    local popup=findImage('PHONE_amg_error_pc.png',0.75,{x=115,y=425,width=185,height=115})
    if popup and #popup>0 then result='AMG_ERROR';break end
    local hits=findImage('PHONE_amg_busy_pc.png',0.75,{x=150,y=375,width=115,height=130})
    local busy=hits and #hits>0
    if busy then AMG_BUSY_SEEN=true;absent=0
    else
        absent=absent+1
        local menu=findImage('PHONE_amg_new.png',0.75,{x=0,y=285,width=120,height=55})
        if absent>=(AMG_BUSY_SEEN and 2 or 3) and menu and #menu==1 then result='AMG_DONE';break end
        if not menu or #menu==0 then
            local home=findImage('PHONE_launch_settings.png',0.75,{x=0,y=240,width=125,height=130})
            if home and #home==1 then result='AMG_LEFT_TO_HOME';break end
        end
    end
    msleep(800)
end
if not result then result=AMG_BUSY_SEEN and 'AMG_WAIT_MORE_BUSY' or 'AMG_WAIT_MORE' end
log(result)

end
parts['US_准备_AMG读IP']=function()
-- AMG 完成后读页面底部红色 IP（注册IP记录，2026-11-06 计划书）。
-- 只扫底部区域文本块（y>=720，逻辑点），正则四段数字且每段<=255 才采纳。
-- 读不到静默返回，不影响任何现有流程（pcall 由调用方包裹）。
local ip=nil
for _,b in ipairs(ocrText()) do
    local t=(b.text or ''):gsub('%s','')
    local a,c,d,e=t:match('(%d%d?%d?)%.(%d%d?%d?)%.(%d%d?%d?)%.(%d%d?%d?)')
    if a and tonumber(a)<=255 and tonumber(c)<=255 and tonumber(d)<=255 and tonumber(e)<=255 then
        local cy=b.y+(b.height or 0)/2
        if cy>=720 then ip=a..'.'..c..'.'..d..'.'..e;break end
    end
end
-- 带上当前账号邮箱，管理器按邮箱精确归因；手机只在「第三次AMG」调用本模块。
-- 独立运行本模块时 currentEmail 为 nil，EMAIL= 为空，管理器会安全跳过（不错写账号）。
if ip then log('AMG_IP='..ip..' EMAIL='..tostring(currentEmail or '')) end

end
parts['US_准备_AppStore下载_开发中']=function()
-- 调度器先执行搜索脚本；只点击一次下载，安装结果由系统应用列表核实。
local name=findText('Vinted: Pre-loved')
local developer=findText('Vinted Limited')
if not name or #name~=1 or not developer or #developer~=1 or math.abs(name[1][2]-developer[1][2])>110 then
    error('App Store 应用名称与开发者不匹配')
end
local h=findImage('PHONE_store_cloud.png',0.75,{x=330,y=530,width=75,height=75})
if not h or #h~=1 or math.abs(h[1][2]-name[1][2])>30 then error('Vinted 下载入口不明确') end
tap(h[1][1],h[1][2]);msleep(1500)
log('VINTED_DOWNLOAD_REQUESTED_VERIFY_INSTALLATION')

end
parts['US_准备_AppStore安装']=function()
local function scan() return ocrText() end
-- 2026-11-05 用户规则：搜索框定位优先找小放大镜图标（PHONE_store_search_mag.png，
-- 38x44 物理像素，取自真机截图），不依赖框内占位文案——文案随 App Store 版本/语言必变。
-- OCR 仅作兜底：公共前缀 'games, apps' 或上轮残留搜索词(vinted)在顶部搜索区。
-- 冷启动加载慢，单轮识别必败，必须轮询等待。
local function searchField()
    local icon=findImage('PHONE_store_search_mag.png',0.75,{x=0,y=120,width=120,height=160})
    if icon and #icon==1 then return {x=icon[1][1],y=icon[1][2],width=0,height=0} end
    for _,b in ipairs(scan()) do
        local t=(b.text or ''):lower()
        if t:find('games, apps',1,true) then return b end
        if t:find('vinted',1,true) and b.y<260 then return b end
    end
end
local b=nil
for i=1,12 do
    b=searchField()
    if b then break end
    if i==4 or i==8 then
        -- 可能在其他标签页：点底部 Search 标签
        local hits=findText('Search');local tab=nil
        for _,v in ipairs(hits or {}) do if v[2]>800 then tab=v end end
        if tab then tap(tab[1],tab[2]) end
    end
    msleep(1000)
end
if not b then error('App Store 搜索框未找到（等待12秒仍无占位文案）') end
tap(b.x+b.width/2,b.y+b.height/2);msleep(600)
-- 2026-11-05 实证：screenWidth/screenHeight 走 SpringBoard 主队列分发，主线程忙时
-- 1.5s 超时返回 0（PHONE_SIZE_MISMATCH 假阳性根因），必须重试而不是一次判死。
local sizeOk=false
for i=1,10 do
    if screenWidth()==414 and screenHeight()==896 then sizeOk=true;break end
    msleep(500)
end
if not sizeOk then error('键盘尺寸未确认') end
local searchKey=findText('search');local keyboard=false
for _,q in ipairs(searchKey or {}) do if q[2]>600 then keyboard=true end end
if not keyboard then error('搜索键盘未显示') end
for _,q in ipairs({{207,737},{309,625},{289,737},{187,625},{104,625},{125,681}}) do tap(q[1],q[2]);msleep(math.random(80,150)) end
msleep(500)
local key=nil
for _,v in ipairs(scan()) do if (v.text or ''):lower()=='search' and v.y>600 then key=v end end
if not key then error('搜索键未找到') end
tap(key.x+key.width/2,key.y+key.height/2);msleep(2500)
local names=findText('Vinted: Pre-loved');local dev=findText('Vinted Limited');local chosen=nil
for _,v in ipairs(names or {}) do if not chosen or v[2]<chosen[2] then chosen=v end end
if not chosen or not dev or #dev<1 then error('Vinted 名称或开发者未找到') end
local cloud=findImage('PHONE_store_cloud.png',0.75,{x=330,y=math.max(0,chosen[2]-40),width=80,height=80})
if not cloud or #cloud~=1 then error('Vinted 下载按钮未找到') end
tap(cloud[1][1],cloud[1][2]);msleep(800)

end
parts['US_准备_AppStore搜索']=function()
-- 从 App Store 搜索页查找 Vinted；只搜索并核验，不触发安装。
local function matching(needle)
    local result={}
    for _,b in ipairs(ocrText()) do
        if (b.text or ''):lower():find(needle,1,true) then result[#result+1]=b end
    end
    return result
end
local fields=matching('games, apps')
if #fields~=1 then error('App Store 搜索框不唯一；停止') end
local field=fields[1]
tap(field.x+field.width/2,field.y+field.height/2)
msleep(500)
for _,q in ipairs({{207,737},{309,625},{289,737},{187,625},{104,625},{125,681}}) do tap(q[1],q[2]);msleep(math.random(80,150)) end
msleep(500)
local keys={}
for _,b in ipairs(ocrText()) do
    if (b.text or ''):lower()=='search' and b.y>screenHeight()*0.65 then keys[#keys+1]=b end
end
if #keys~=1 then error('键盘搜索键不唯一；停止') end
local key=keys[1]
tap(key.x+key.width/2,key.y+key.height/2)
msleep(3500)
local names=matching('vinted: pre-loved')
local developers=matching('vinted limited')
if #names<1 or #developers<1 then error('搜索结果未同时识别到目标名称与开发者') end
log('US_APPSTORE_SEARCH_OK',#names,#developers)

end
parts['US_准备_Safari清理_开发中']=function()
-- 调度器先打开 Safari 设置页；执行一次清理。屏幕位置变化时停止。
local function oneText(text)
    local h=findText(text)
    if not h or #h~=1 then error('页面文字不唯一：'..text) end
    return h[1]
end
local found=nil
for _=1,7 do
    msleep(1400)
    local h=findText('Clear History')
    if h and #h==1 and h[1][2]>90 and h[1][2]<820 then found=h[1];break end
    swipe(200,720,200,330,450)
end
if not found then error('Safari 清理入口未找到') end
tap(found[1],found[2]);msleep(650)
local buttons={}
for _,b in ipairs(ocrText()) do
    if (b.text or ''):lower():find('clear history and data',1,true) and b.y>650 then buttons[#buttons+1]=b end
end
if #buttons~=1 then error('Safari 清理确认不唯一') end
local b=buttons[1];tap(b.x+b.width/2,b.y+b.height/2);msleep(1300)
local close=findText('Close Tabs')
if close and #close==1 and close[1][2]>650 then tap(close[1][1],close[1][2]);msleep(900) end
log('SAFARI_CLEAR_REQUEST_COMPLETED')

end
parts['US_准备_Safari进入_开发中']=function()
-- 打开设置后从当前列表位置进入 Safari；已在 Safari 时不重复进入。
local function safariTitle()
    local h=findText('Safari')
    for _,p in ipairs(h or {}) do if p[2]<100 and p[1]>100 then return true end end
    return false
end
if not safariTitle() then
    -- 设置列表可保留上次滚动位置；点状态栏回到列表顶部后单向查找。
    tap(screenWidth()/2,20);msleep(700)
    local entered=false
    for i=1,12 do
        msleep(1000)
        local h=findText('Safari');local row=nil
        for _,p in ipairs(h or {}) do if p[2]>100 and p[2]<800 then row=p;break end end
        if row then
            msleep(1200)
            h=findText('Safari');row=nil
            for _,p in ipairs(h or {}) do if p[2]>100 and p[2]<800 then row=p;break end end
            if not row then error('Safari 设置项滚动后已变化') end
            tap(row[1],row[2]);msleep(1200);entered=safariTitle();break
        end
        swipe(200,720,200,350,450)
    end
    if not entered then error('无法进入 Safari 设置') end
end

end
parts['US_准备_Vinted卸载菜单定位']=function()
-- 检查主屏应用图标，打开长按菜单并定位移除入口；不点击删除。
local w,h=screenWidth(),screenHeight()
if w~=414 or h~=896 then error('当前屏幕尺寸与手机模板不匹配') end
local icon=findImage('PHONE_vinted.png',0.75,{x=210,y=385,width=95,height=75})
if not icon or #icon~=1 then error('未在预期主屏位置找到 Vinted') end
local p=icon[1]
touchDown(0,p[1],p[2]);msleep(1100);touchUp(0,p[1],p[2]);msleep(800)
local menu=findImage('PHONE_remove_app.png',0.75,{x=40,y=530,width=160,height=75})
if not menu or #menu~=1 then error('未确认 Vinted 移除菜单') end
log('VINTED_REMOVE_MENU_CONFIRMED',menu[1][1],menu[1][2],menu[1][3])

end
parts['US_准备_卸载Vinted']=function()
-- 主屏图标移动后以标签确定查找区域；每个确认框都核对目标应用。
-- 调度器已经通过屏幕滑动回到主屏。
local labels=findText('Vinted')
if not labels or #labels~=1 then error('主屏 Vinted 标签未找到') end
local x,y=labels[1][1],labels[1][2]
local left=math.max(0,math.min(319,x-48))
local icon=findImage('PHONE_vinted.png',0.75,{x=left,y=math.max(0,y-88),width=95,height=75})
if not icon or #icon~=1 then error('Vinted 图标未找到') end
local p=icon[1];touchDown(0,p[1],p[2]);msleep(1100);touchUp(0,p[1],p[2]);msleep(700)
local remove=findText('Remove App')
if not remove or #remove~=1 then error('移除菜单未找到') end
tap(remove[1][1],remove[1][2]);msleep(700)
local target=findText('Vinted');local action=findText('Delete App')
if not target or #target<1 or not action or #action~=1 then error('删除应用确认不明确') end
tap(action[1][1],action[1][2]);msleep(700)
target=findText('Vinted');local options=findText('Delete');local final={}
for _,v in ipairs(options or {}) do if v[1]>200 and v[2]>450 and v[2]<560 then final[#final+1]=v end end
if not target or #target<1 or #final~=1 then error('最终删除确认不明确') end
tap(final[1][1],final[1][2]);msleep(1500)

end
parts['US_准备_卸载Vinted_开发中']=function()
-- 本机主屏布局适配。删除前每一层都核对当前画面，任何不明确都停止。
if screenWidth()~=414 or screenHeight()~=896 then error('设备尺寸不匹配') end
local function image(name,area)
    local hits=findImage('PHONE_'..name..'.png',0.75,area)
    if not hits or #hits~=1 then error('页面模板未确认：'..name) end
    return hits[1]
end
local icon=image('vinted',{x=210,y=385,width=95,height=75})
touchDown(0,icon[1],icon[2]);msleep(1100);touchUp(0,icon[1],icon[2]);msleep(800)
local menu=image('remove_app',{x=40,y=530,width=160,height=75})
tap(menu[1],menu[2]);msleep(800)
local function target()
    local h=findText('Vinted')
    if not h or #h<1 then error('确认框缺少 Vinted 名称') end
end
target()
local remove=image('delete_app',{x=120,y=430,width=170,height=60})
tap(remove[1],remove[2]);msleep(800)
target()
local confirm=image('delete_confirm',{x=220,y=480,width=125,height=65})
tap(confirm[1],confirm[2]);msleep(2000)
log('VINTED_DELETE_SENT_VERIFY_INSTALLATION_STATE')

end
parts['US_准备_小火箭开启']=function()
-- 只读取 UI；开关操作由调度器通过 tap 发出。
-- 2026-11-06 实证重写（iPhone11 414x896，中文界面）：
-- 旧版单点取色(330,134)落在开关白色镂空区恒为0xFFFFFF，把"已连接"误判为关；
-- 且 OCR 把"未连接"误读为"末连接"，原样匹配不到。ON 态状态行显示节点地址（如 proxy.simplyproxies.com:6890），无"连接"字样。
-- 新逻辑：多点采样开关区蓝色像素判开（ON=2473bd 蓝红差153；OFF=灰 e9e9eb 差2；阈值60，>=4点判开）；
-- 状态行(y 95..165)认"未连接/末连接/not connected"为关、"连接中/connecting"为连接中；蓝色优先，灰色无连接文案才判关。
local titles=findText('Shadowrocket');local title=false
for _,p in ipairs(titles or {}) do if p[2]<100 then title=true end end
if not title then error('不在小火箭页面') end
local blue=0
for x=322,374,4 do
 for y=118,150,4 do
  local c=getColor(x,y)
  if type(c)=='number' and ((c&255)-((c>>16)&255))>=60 then blue=blue+1 end
 end
end
local lines=ocrText();if not lines or #lines==0 then error('小火箭状态无法读取') end
local offText=false;local connText=false
for _,b in ipairs(lines) do
 local y=b.y or 0
 if y>=95 and y<=165 then
  local raw=tostring(b.text or '');local t=raw:lower()
  if t:find('not connected',1,true) or raw:find('未连接',1,true) or raw:find('末连接',1,true) then offText=true end
  if t:find('connecting',1,true) or raw:find('连接中',1,true) then connText=true end
 end
end
if blue>=4 then
 if connText then log('SHADOW_CONNECTING') else log('SHADOW_ON') end
else
 if connText then log('SHADOW_CONNECTING') else log('SHADOW_OFF') end
end

end
parts['US_准备_注册页前置']=function()
-- 先处理当前权限弹窗，不用 Home 打断系统弹窗。
local handled=false
local hits=findImage('PHONE_vinted_network_both.png',0.75,{x=90,y=440,width=235,height=70})
if hits and #hits>1 then error('网络权限按钮匹配不唯一') end
if hits and #hits==1 then
    tap(hits[1][1],hits[1][2]);msleep(1800)
    handled=true;log('VINTED_NETWORK_ALLOWED')
end
local fields={['fullname']=false,['username']=false,['email']=false,['password']=false,['zipcode']=false}
local present=handled
local permission=false
for _,b in ipairs(ocrText()) do
    local text=(b.text or ''):lower()
    local norm=text:gsub('[%s%p]','')
    if fields[norm]~=nil then fields[norm]=true end
    if norm:find('signupforvinted',1,true) or norm:find('continuewithemail',1,true) then present=true end
    if norm:find('wlanonly',1,true) or norm:find('wirelessdata',1,true) then permission=true end
    if norm:find('sessionhasbeenblocked',1,true) then log('VINTED_SESSION_BLOCKED');error('SERVER_BLOCKED_STOP') end
end
if permission then error('网络权限弹窗仍未关闭') end
local ready=true
for _,value in pairs(fields) do if not value then ready=false end end
if ready then log('VINTED_FORM_READY') elseif present then log('VINTED_PAGE_PRESENT') else log('VINTED_PAGE_UNKNOWN') end

end
parts['US_准备_节点轮转']=function()
-- 节点轮转：识图点击为主、OCR 兜底（2026-11-07，见 节点轮转识图点击改造计划书）。
-- 由主脚本「关闭小火箭」阶段直接调用 parts['US_准备_节点轮转']()，不经 run()/withScreen：
-- withScreen 会缓存一帧（gEnergyFrame/gEnergyOCR），tap 后 OCR 会读到旧画面，验证必然失败。
-- 失败一律 error 上抛：外层 3 次重试后本账号失败换号，全程自动、不停不等人。
local getter=nil
if type(at)=='table' and type(at.httpGet)=='function' then getter=at.httpGet
elseif type(httpGet)=='function' then getter=httpGet end
-- 管理器尚未升级 / 局域网不通时直接跳过：不启用节点轮转的账号必须照常跑，
-- 绝不能因为辅助功能不可用就烧账号。只有「已启用但找不到节点/点不中」才 error 换号。
if not getter then log('NODE_API_SKIP no httpGet');return end
local body,err=getter('http://192.168.2.100:8766/node.json')
if not body or not body:find('"enabled"',1,true) then log('NODE_API_SKIP '..tostring(err));return end
local enabled=body:find('"enabled"%s*:%s*true')~=nil
local node=body:match('"node"%s*:%s*"([^"]*)"')
if not enabled or not node or node=='' then log('NODE_SKIP');return end
local region={x=0,y=310,width=414,height=500}
local hit=nil
-- 识图为主：模板由管理器按本轮节点复制成 Images/US_NODE_TARGET.png；pcall 防 2s 预算击穿。
local okImg,hits=pcall(findImage,'US_NODE_TARGET.png',0.80,region)
if okImg and type(hits)=='table' and #hits>=1 then hit=hits[1];log('NODE_IMAGE_HIT') end
if not hit then
  -- OCR 兜底：按工作台配置的节点名找文字，只取列表区域内的命中。
  local okTxt,txt=pcall(findText,node)
  if okTxt and type(txt)=='table' then
    for _,p in ipairs(txt) do
      if type(p)=='table' and p[2] and p[2]>310 and p[2]<810 then hit=p;break end
    end
  end
  if hit then log('NODE_OCR_HIT') end
end
if not hit then error('NODE_NOT_FOUND '..node) end
tap(hit[1],hit[2]);msleep(900)
-- 验证（最多 3 次轮询，任一通过即可）：
-- ① 识图：左侧「选中橙点」模板命中且落在目标行附近（像素级，最可靠；
--    真机实测顶部 OCR 会把 "111" 读错，不能只靠文字）。
-- ② OCR 兜底：顶部大卡片当前节点名（物理 y 250-284 → 逻辑 y<200），
--    规范化 1/l/I 与空格后再比对。
local function normalized(s)
  local t=tostring(s or ''):lower()
  t=t:gsub('[%s|]','')
  t=t:gsub('[il]','1')
  return t
end
local verified=false
for i=1,3 do
  local okDot,dots=pcall(findImage,'US_NODE_SELECTED_DOT.png',0.75,{x=0,y=300,width=100,height=520})
  if okDot and type(dots)=='table' and #dots>=1 and type(dots[1])=='table' then
    local dy=(dots[1][2] or 0)-hit[2]
    if dy>-25 and dy<25 then verified=true;log('NODE_DOT_VERIFIED') end
  end
  if not verified then
    local okOCR,blocks=pcall(ocrText)
    if okOCR and type(blocks)=='table' then
      local want=normalized(node)
      for _,b in ipairs(blocks) do
        if type(b)=='table' and (b.y or 0)<200 and normalized(b.text):find(want,1,true) then
          verified=true;log('NODE_OCR_VERIFIED');break
        end
      end
    end
  end
  if verified then break end
  msleep(700)
end
if not verified then error('NODE_SWITCH_UNVERIFIED '..node) end
log('NODE_SWITCHED='..node)

end
parts['US_准备_页面只读检查']=function()
-- 准备阶段页面识别：只读取画面，不点击、不更改手机数据。
log('US_PREPARATION_READONLY_BEGIN')
local ok, blocks = pcall(ocrText)
if not ok or type(blocks) ~= 'table' then error('屏幕或 OCR 不可用') end
local markers = {safari=0, clear=0, amg=0, original=0, fresh=0, appstore=0}
for _, b in ipairs(blocks) do
    local s = tostring(b.text or ''):lower()
    if s:find('safari', 1, true) then markers.safari=markers.safari+1 end
    if s:find('clear history', 1, true) or s:find('清除历史', 1, true) then markers.clear=markers.clear+1 end
    if s:find('amg', 1, true) then markers.amg=markers.amg+1 end
    if s:find('原始机', 1, true) then markers.original=markers.original+1 end
    if s:find('一键新', 1, true) then markers.fresh=markers.fresh+1 end
    if s:find('app store', 1, true) then markers.appstore=markers.appstore+1 end
end
log('US_PREPARATION_SCREEN',screenWidth(),screenHeight(),
    'safari',markers.safari,'clear',markers.clear,'amg',markers.amg,
    'original',markers.original,'fresh',markers.fresh,'appstore',markers.appstore)
log('US_PREPARATION_READONLY_END')

end
parts['home']=function()
local function homeVisible()
 local a=findText('App Store');local b=findText('Shadowrocket')
 return a and #a>0 and b and #b>0
end
if not homeVisible() then
 keyDown(KEY_TYPE.HOME_BUTTON);msleep(80)
 keyUp(KEY_TYPE.HOME_BUTTON);msleep(1200)
end
if not homeVisible() then error('模拟 Home 键后未返回主屏') end
end
parts['close_apps']=function()
for i=1,2 do
 keyDown(KEY_TYPE.HOME_BUTTON);msleep(60);keyUp(KEY_TYPE.HOME_BUTTON);msleep(100)
end
msleep(700)
for i=1,12 do
 swipe(200,650,200,100,350);msleep(500)
 local home=findImage('PHONE_launch_settings.png',0.75,{x=0,y=240,width=125,height=130})
 if home and #home==1 then log('APP_SWITCHER_CLEARED_TO_HOME');return end
end
error('后台清理后未确认返回主屏')
end
parts['proxy_off']=function()
local function offSeen()
 for _,b in ipairs(ocrText()) do
  local y=b.y or 0
  if y>=95 and y<=165 then
   local t=tostring(b.text or '')
   if t:find('未连接',1,true) or t:find('末连接',1,true) or t:lower():find('not connected',1,true) then return true end
  end
 end
 return false
end
local function blueCount()
 local n=0
 for x=322,374,4 do
  for y=118,150,4 do
   local c=getColor(x,y)
   if type(c)=='number' and ((c&255)-((c>>16)&255))>=60 then n=n+1 end
  end
 end
 return n
end
if offSeen() then return end
if blueCount()>=4 then
 tap(350,134);msleep(1500)
 if offSeen() then return end
 error('小火箭未关闭')
end
error('小火箭状态不明确')
end
parts['open_form']=function()
msleep(1000)
-- 2026-11-05 实证：每次重装后首启 iOS 弹"允许 Vinted 使用无线数据？"系统弹窗挡住整个
-- 页面（当日 4 次"美国版注册入口未找到"均因此）。见到就点"WLAN & Cellular"放行。
for _=1,3 do
 local dlg=findText('wireless data');local allow=findText('WLAN & Cellular')
 if dlg and #dlg>0 and allow and #allow==1 then tap(allow[1][1],allow[1][2]);msleep(2000) else break end
end
-- 2026-11-06 用户规则：找"Sign up for Vinted"注册按钮的等待轮数 12→24 翻倍
-- （名义睡眠 12×0.7≈8.4s → 16.8s；含每轮 OCR 墙钟约 25s → 50-60s），
-- Vinted 冷启动慢的机型不再误报"美国版注册入口未找到"。
local entry=nil
for i=1,24 do
 local blocked=findText('session has been blocked');if blocked and #blocked>0 then log('VINTED_SESSION_BLOCKED');error('SERVER_BLOCKED_STOP') end
 local dlg2=findText('WLAN & Cellular')
 if dlg2 and #dlg2==1 and (not findText('Sign up for Vinted') or #findText('Sign up for Vinted')~=1) then tap(dlg2[1][1],dlg2[1][2]);msleep(2000) end
 entry=findText('Sign up for Vinted');if entry and #entry==1 then break end
 msleep(700)
end
if not entry or #entry~=1 then error('美国版注册入口未找到') end
tap(entry[1][1],entry[1][2]);msleep(700)
local email=nil
for i=1,6 do email=findText('Continue with email');if email and #email==1 then break end;msleep(500) end
if not email or #email~=1 then error('邮箱注册入口未找到') end
tap(email[1][1],email[1][2]);msleep(800)
-- 双表单：旧五字段(full name/email/password/zip code/username)与新三字段(username/email/password)
-- 都必须通过（2026-11-05 实证新表单被旧的"必须有 full name+zip"误判拒掉）。
local labels={['full name']=false,['username']=false,['email']=false,['password']=false,['zip code']=false}
for _,b in ipairs(ocrText()) do local s=(b.text or ''):lower();if labels[s]~=nil then labels[s]=true end end
if not labels['email'] or not labels['password'] then error('空白注册表单未确认') end
if not labels['full name'] and not labels['username'] then error('空白注册表单未确认') end
log('OPEN_FORM_OK new='..tostring(not labels['full name']))
end
parts['observe']=function()
-- 只观察页面，不触摸人机验证控件。
-- 2026-11-06 用户裁定：识图模板为主、OCR 子串兜底（封号页此前漏判成失败）。
local accountBlocked=false
pcall(function()
 if #findImage('US400_account_blocked_title.png',0.75,{x=0,y=300,width=414,height=140})>0 then accountBlocked=true end
end)
local human,blocked,phone,field,verify,email=false,false,false,false,false,false
for _,b in ipairs(ocrText()) do
 local text=(b.text or ''):lower()
 local norm=text:gsub('[%s%p]','')
 if text:find('human',1,true) and text:find('verify',1,true) then human=true end
 if text:find('session has been blocked',1,true) then blocked=true end
 -- 2026-11-05 实证：注册提交后可能直接出现账号级封禁页（Your account is blocked ... terms of use）
 -- OCR 兜底：模板未命中时靠这两组子串（与 generate_phone_flow.py 内联检查同口径）
 if text:find('account is blocked',1,true) or text:find('blocked your account',1,true) then accountBlocked=true end
 if text:find('phone number',1,true) then phone=true end
 if norm=='verify' then verify=true end
 if text:find('verification code',1,true) or text:find('enter code',1,true) then field=true end
 if text:find('email',1,true) or text:find('inbox',1,true) then email=true end
end
if accountBlocked then log('PAGE_ACCOUNT_BLOCKED')
elseif blocked then log('PAGE_BLOCKED')
elseif human then log('PAGE_HUMAN_VERIFICATION')
elseif phone then log('PAGE_PHONE_VERIFICATION')
elseif field and (verify or email) then log('PAGE_EMAIL_CODE')
else log('PAGE_UNKNOWN') end

end
parts['slider']=function()
-- 欢迎滑块自动通过（依据：滑块实现计划书_2026-11-04.md / 步骤书）
-- 全部元素模板化：盾牌图标判定页面，手柄模板动态定位（默认位置变了也能找到），
-- 终点=手柄中心相对右移+222逻辑点（不做目标框模板），RETRY 橙色按钮模板检测重试。
-- region 为逻辑点（内部×2转物理）。2026-11-05 实证：y起点140→物理280，盾牌模板顶268超出12px会整版漏检，区域必须含整模板。
-- 日志标记：SLIDER_DETECTED / SLIDER_HANDLE_NOT_FOUND / SLIDER_PASSED / SLIDER_RETRY_TAPPED / SLIDER_RETRY_EXHAUSTED
if screenWidth()~=414 or screenHeight()~=896 then error('设备尺寸不匹配') end

local SIM=0.75
local DRIFT_X=222 -- 终点=手柄中心右移距离（标定：目标框中心640.5 - 手柄中心197 = 443.5phys，÷2≈222）

local function detectIcon()
 -- 2026-11-05 实证：脚本首帧捕获可能为空，单发 findImage 会误判"非滑块页"，必须轮询
 for i=1,3 do
  local hits=findImage('PHONE_slider_shield.png',SIM,{x=110,y=110,width=200,height=240})
  if hits and #hits>0 then return hits[1] end
  msleep(500)
 end
 return nil
end

local function detectHandle(icon)
 local region={x=icon[1]-200,y=icon[2]+225,width=240,height=90}
 local hits=findImage('PHONE_slider_handle.png',SIM,region)
 if not hits or #hits==0 then return nil end
 return hits[1]
end

local function detectRetry(icon)
 local region={x=icon[1]-140,y=icon[2]+200,width=280,height=90}
 local hits=findImage('PHONE_slider_retry.png',SIM,region)
 if not hits or #hits==0 then return nil end
 return hits[1]
end

local function dragHandle(sx,sy,ex,ey)
 local id=0
 local ox=math.random(-3,3)
 local oy=math.random(-3,3)
 touchDown(id,sx+ox,sy+oy)
 msleep(100+math.random(0,120))
 local x=sx+ox
 while x<ex-2 do
  local step=math.random(5,22)
  x=math.min(ex,x+step)
  touchMove(id,x,sy+math.random(-2,2))
  msleep(math.random(6,22))
 end
 msleep(80+math.random(0,80))
 touchMove(id,ex+math.random(-1,1),ey+math.random(-2,2))
 msleep(60+math.random(0,60))
 touchUp(id,ex+math.random(-3,3),ey+math.random(-3,3))
end

local icon=detectIcon()
if not icon then return end -- 非滑块页，静默（无 SLIDER_DETECTED 标记）
log('SLIDER_DETECTED')
for round=1,3 do
 local handle=detectHandle(icon)
 if not handle then
  -- 过不了就重过：没有手柄说明挑战已是失败态，点 RETRY 重开，等15秒进入下一轮
  local retry0=detectRetry(icon)
  if retry0 then
   log('SLIDER_RETRY_TAPPED')
   tap(retry0[1],retry0[2])
   msleep(15000)
  else
   log('SLIDER_HANDLE_NOT_FOUND')
   return
  end
 else
  local sx,sy=handle[1],handle[2]
  log('SLIDER_DRAG round='..round..' start='..sx..','..sy)
  dragHandle(sx,sy,sx+DRIFT_X,sy)
  msleep(1500)
  local retry=detectRetry(icon)
  if not retry then
   log('SLIDER_PASSED')
   return
  end
  log('SLIDER_RETRY_TAPPED')
  tap(retry[1],retry[2])
  msleep(15000)
 end
end
log('SLIDER_RETRY_EXHAUSTED')
-- 滑块部分结束

end
parts['fill']=function()
-- 开发中：基于OCR锚点和多点图色验证数字键盘，只返回候选坐标，不发送触摸。
-- 各次getColor不是同一冻结帧，因此只可作为受控测试，未通过完整真机负例前不接入注册。
local function us_locate_numeric_keypad(blocks, width, height, get_color)
    if type(blocks) ~= 'table' or type(width) ~= 'number' or type(height) ~= 'number' or type(get_color) ~= 'function' then return nil, '参数错误' end
    local a = {}
    for _, b in ipairs(blocks) do
        local t = tostring(b.text or ''):gsub('%s','')
        if t:match('^[1-9]$') and type(b.x)=='number' and type(b.y)=='number' and type(b.width)=='number' and type(b.height)=='number' and b.y > height*0.5 then
            if a[t] then return nil, '数字锚点重复' end
            a[t] = {b.x+b.width/2,b.y+b.height/2}
        end
    end
    local anchors={}
    for d=1,9 do
        local point=a[tostring(d)]
        if point then anchors[#anchors+1]={point[1],point[2],(d-1)%3,math.floor((d-1)/3)} end
    end
    if #anchors<5 then return nil, '数字锚点不足' end
    local dxsum,dysum,dxcount,dycount=0,0,0,0
    for i=1,#anchors do for j=i+1,#anchors do
        local p,q=anchors[i],anchors[j]
        if p[3]~=q[3] then dxsum=dxsum+(q[1]-p[1])/(q[3]-p[3]);dxcount=dxcount+1 end
        if p[4]~=q[4] then dysum=dysum+(q[2]-p[2])/(q[4]-p[4]);dycount=dycount+1 end
    end end
    if dxcount==0 or dycount==0 then return nil, '锚点布局不足' end
    local dx,dy=dxsum/dxcount,dysum/dycount
    if dx<width*0.19 or dx>width*0.40 or dy<height*0.035 or dy>height*0.10 then return nil, '键盘间距不符合' end
    local bx,by=0,0
    for _,p in ipairs(anchors) do bx=bx+p[1]-p[3]*dx;by=by+p[2]-p[4]*dy end
    bx,by=bx/#anchors,by/#anchors
    for _,p in ipairs(anchors) do
        if math.abs(p[1]-(bx+p[3]*dx))>width*0.025 or math.abs(p[2]-(by+p[4]*dy))>height*0.02 then
            return nil, '数字锚点排列不符合'
        end
    end
    local x1,x2,x3=bx,bx+dx,bx+2*dx
    local xs={x1,x2,x3};local ys={by,by+dy,by+2*dy,by+3*dy}
    local offset=dx*0.22
    local function white(x,y)
        x=math.floor(x+0.5);y=math.floor(y+0.5)
        if x<0 or y<0 or x>=width or y>=height then return nil end
        local c=get_color(x,y)
        if type(c)~='number' then return nil end
        local red=(c>>16)&255;local green=(c>>8)&255;local blue=c&255
        return math.min(red,green,blue)>235 and math.max(red,green,blue)-math.min(red,green,blue)<25
    end
    for row=1,4 do
        for col=1,3 do
            local expected=row<4 or col==2
            local left=white(xs[col]-offset,ys[row]+10)
            local right=white(xs[col]+offset,ys[row]+10)
            if left==nil or right==nil or left~=expected or right~=expected then return nil, '按键图色不匹配' end
        end
    end
    for row=1,3 do
        if white((x1+x2)/2,ys[row]+10) ~= false or white((x2+x3)/2,ys[row]+10) ~= false then
            return nil, '列间隔未确认'
        end
    end
    for row=1,3 do
        if white(x2+offset,ys[row]+dy*0.66) ~= false then return nil, '行间隔未确认' end
    end
    local result={}
    for row=1,3 do for col=1,3 do result[tostring((row-1)*3+col)]={xs[col],ys[row]} end end
    result['0']={x2,ys[4]}
    return result
end

-- 与美国版 us_form.zip_match_ratio 的字符匹配规则对应。
-- 输入为ZIP字符串与OCR结果列表；仅在确认ZIP数字字段后使用。
-- 按Unicode码点比较并去除Python str.split()识别的空白。
local function us_is_space(c)
    return (c>=9 and c<=13) or (c>=28 and c<=32) or c==0x85 or c==0xa0 or c==0x1680 or
           (c>=0x2000 and c<=0x200a) or c==0x2028 or c==0x2029 or c==0x202f or c==0x205f or c==0x3000
end
local function us_characters(text, strip_space)
    local result={}
    for _,c in utf8.codes(text) do
        if not strip_space or not us_is_space(c) then result[#result+1]=c end
    end
    return result
end

local function us_longest_block(a, b, alo, ahi, blo, bhi)
    local best_i, best_j, best_len = alo, blo, 0
    local previous = {}
    for i = alo, ahi do
        local current = {}
        for j = blo, bhi do
            if a[i] == b[j] then
                local size = (previous[j - 1] or 0) + 1
                current[j] = size
                if size > best_len then
                    best_i, best_j, best_len = i - size + 1, j - size + 1, size
                end
            end
        end
        previous = current
    end
    return best_i, best_j, best_len
end

local function us_zip_ratio(value, lines)
    local text = us_characters(table.concat(lines or {}, ""), true)
    if #text == 0 then return 0 end
    local expected = us_characters(value, false)
    local stack = {{1, #expected, 1, #text}}
    local matched = 0
    while #stack > 0 do
        local range = table.remove(stack)
        local i, j, size = us_longest_block(expected, text, range[1], range[2], range[3], range[4])
        if size > 0 then
            matched = matched + size
            if range[1] < i and range[3] < j then
                stack[#stack + 1] = {range[1], i - 1, range[3], j - 1}
            end
            if i + size <= range[2] and j + size <= range[4] then
                stack[#stack + 1] = {i + size, range[2], j + size, range[4]}
            end
        end
    end
    return 2 * matched / (#expected + #text)
end

-- 研发预检：只对已被条款模板及几何约束确认的候选点分类；不执行触摸。
-- getColor每次重新截图；动态页面和动画可能改变画面，调用者必须重新定位复核。
local function us_checkbox_classify(get_color,x,y,width,height)
    if type(get_color)~='function' or type(x)~='number' or type(y)~='number' or
       type(width)~='number' or type(height)~='number' then return 'unknown' end
    x=math.floor(x+0.5);y=math.floor(y+0.5)
    if x<13 or y<13 or x+13>=width or y+13>=height then return 'unknown' end
    local function sample(dx,dy)
        local c=get_color(x+dx,y+dy)
        if type(c)~='number' then return nil end
        local r=(c>>16)&255;local g=(c>>8)&255;local b=c&255
        if r>230 and g>230 and b>230 and math.max(r,g,b)-math.min(r,g,b)<25 then return 'white' end
        if g>70 and b>60 and r<100 and g-r>35 and b-r>20 then return 'teal' end
        if math.max(r,g,b)<180 and math.max(r,g,b)-math.min(r,g,b)<35 then return 'dark' end
        return 'other'
    end
    local teal,white=0,0
    for dx=-8,8,4 do for dy=-8,8,4 do
        local c=sample(dx,dy)
        if not c then return 'unknown' end
        if c=='teal' then teal=teal+1 elseif c=='white' then white=white+1 end
    end end
    if teal>=6 and white>=1 then return 'checked' end
    if teal>0 then return 'unknown' end
    for _,p in ipairs({{0,0},{-6,0},{6,0},{0,-6},{0,6}}) do
        if sample(p[1],p[2])~='white' then return 'unknown' end
    end
    for _,p in ipairs({{-12,0},{11,0},{0,-12},{0,11}}) do
        if sample(p[1],p[2])~='dark' then return 'unknown' end
    end
    return 'unchecked'
end

-- 条款状态机的测试组件，不自行读取屏幕或执行输入；所需函数由调用者提供。
-- 每次只允许点击一次；坐标从新条款锚点平移复核，模糊/失败直接停止。
local function us_check_terms_once(anchor,find_empty,find_checked,classify,click,pause,max_checks)
    if type(max_checks)~='number' or max_checks<1 or max_checks>12 or max_checks~=math.floor(max_checks) then
        error('条款核验次数无效',0)
    end
    local a=anchor()
    if not a or type(a.x)~='number' or type(a.y)~='number' then error('未找到条款锚点',0) end
    local empty=find_empty(a)
    local checked=find_checked(a)
    local point=empty or checked
    if not point or type(point.x)~='number' or type(point.y)~='number' or
       point.x>=a.x or math.abs(point.y-a.y)>80 then error('未确认条款左侧复选框',0) end
    local before=classify(point)
    if before=='checked' then return 'already_checked' end
    if before~='unchecked' then error('复选框图色未确认',0) end
    local dx,dy=point.x-a.x,point.y-a.y
    click(point)
    for _=1,max_checks do
        pause(500)
        local current=anchor()
        if not current or type(current.x)~='number' or type(current.y)~='number' then error('点击后条款锚点消失',0) end
        local expected={x=current.x+dx,y=current.y+dy}
        local state=classify(expected)
        if state=='checked' then return 'checked' end
    end
    error('条款点击后未确认勾选；不会再次点击',0)
end


-- iPhone 11 / 414x896，实机邮箱键盘独立映射。
-- 不复用普通键盘的数字/符号页；按键后等待100..500毫秒。
local emailKeys={alpha={},number={},symbol={}}
local function emailRow(page,text,y,x,dx)
 for i=1,#text do emailKeys[page][text:sub(i,i)]={x+(i-1)*dx,y} end
end
emailRow('alpha','qwertyuiop',626,22,41)
emailRow('alpha','asdfghjkl',682,43,41)
emailRow('alpha','zxcvbnm',738,84,41)
emailRow('number','1234567890',626,22,41)
emailRow('symbol','`|{}?%^*/\'',626,22,41)
for _,page in ipairs({'number','symbol'}) do
 emailRow(page,'$!~&=#[]',682,46,46)
 emailRow(page,'._-+',738,101,71)
end
local emailPage='alpha'
local function emailTap(x,y) tap(x,y);msleep(math.random(100,500)) end
local function emailReset()
 local abc=findImage('PHONE_keyboard_abc.png',0.75,{x=0,y=770,width=55,height=50})
 if abc and #abc==1 then emailTap(27,795)
 else
  local numbers=findImage('PHONE_keyboard_123.png',0.75,{x=0,y=770,width=55,height=50})
  if not numbers or #numbers~=1 then error('邮箱键盘未确认') end
 end
 emailPage='alpha'
end
local function emailSelect(page)
 if emailPage==page then return end
 if emailPage=='alpha' then emailTap(27,795);emailPage='number' end
 if page=='alpha' then emailTap(27,795);emailPage='alpha'
 elseif page~=emailPage then emailTap(27,738);emailPage=page end
end
local function emailType(value)
 if screenWidth()~=414 or screenHeight()~=896 then
  error('邮箱键盘映射仅核对过414x896逻辑坐标，已停止输入')
 end
 value=value:lower()
 for i=1,#value do
  local c=value:sub(i,i)
  if c~='@' and c~='.' and not emailKeys.alpha[c] and not emailKeys.number[c] and not emailKeys.symbol[c] then error('邮箱字符没有实机映射') end
 end
 emailReset()
 for i=1,#value do
  local c=value:sub(i,i)
  if c=='@' or c=='.' then emailSelect('alpha');emailTap(c=='@' and 233 or 284,795)
  else
   local page=emailKeys.alpha[c] and 'alpha' or (emailKeys.number[c] and 'number' or 'symbol')
   emailSelect(page);local key=emailKeys[page][c];emailTap(key[1],key[2])
  end
 end
 emailSelect('alpha')
end
local function emailPunctuation(value)
 return value:lower():gsub('%s',''):gsub('[%w]','')
end
local function emailReadMatches(expected,text,y)
 text=(text or ''):lower():gsub('%s','')
 local expectedMarks=emailPunctuation(expected)
 if not text:find('@',1,true) then
  -- Vision sometimes reads the real @ glyph as 'a'. Require its image instead.
  local hits=findImage('PHONE_email_value_at.png',0.75,{x=0,y=math.max(0,y-22),width=screenWidth(),height=44})
  if not hits or #hits~=1 then return false end
  expectedMarks=expectedMarks:gsub('@','')
 end
 return emailPunctuation(text)==expectedMarks and us_zip_ratio(expected:lower(),{text})>=0.60
end

-- iPhone 11 QWERTY 屏幕键盘；只用点击，不发送 HID 键盘事件。
local screenPage='alpha'
local screenKeys={alpha={},number={},symbol={}}
local function row(page,text,y,x,dx)
 for i=1,#text do screenKeys[page][text:sub(i,i)]={x+(i-1)*dx,y} end
end
row('alpha','qwertyuiop',626,22,41)
row('alpha','asdfghjkl',682,43,41)
row('alpha','zxcvbnm',738,84,41)
row('number','1234567890',626,22,41)
row('number','-/:;()$&@"',682,22,41)
row('symbol','[]{}#%^*+=',626,22,41)
row('symbol','_\\|~<>',682,22,41)
for _,page in ipairs({'number','symbol'}) do row(page,'.,?!\'',738,94,56) end
local function screenTap(x,y) tap(x,y);msleep(math.random(100,500)) end
local function screenReset()
 local abc=findImage('PHONE_keyboard_abc.png',0.75,{x=0,y=770,width=55,height=50})
 if abc and #abc==1 then screenTap(27,795)
 else
  local numbers=findImage('PHONE_keyboard_123.png',0.75,{x=0,y=770,width=55,height=50})
  if not numbers or #numbers~=1 then error('屏幕键盘布局未确认') end
 end
 screenPage='alpha'
end
local function screenSelect(page)
 if screenPage==page then return end
 if screenPage=='alpha' then screenTap(27,795);screenPage='number' end
 if page=='alpha' then screenTap(27,795);screenPage='alpha'
 elseif page~=screenPage then screenTap(27,738);screenPage=page end
end
local function screenKey(page,x,y,upper)
 screenSelect(page)
 if page=='alpha' then
  local color=getColor(15,721)
  if not color then error('Shift 状态不可读') end
  local active=math.min((color>>16)&255,(color>>8)&255,color&255)>225
  if active~=upper then screenTap(27,738) end
 end
 screenTap(x,y)
end
local function screenType(value)
 if value:match('^%d+$') and us_locate_numeric_keypad then
  local keys=us_locate_numeric_keypad(ocrText(),screenWidth(),screenHeight(),getColor)
  if keys then
   for i=1,#value do local key=keys[value:sub(i,i)];screenTap(key[1],key[2]) end
   return
  end
 end
 screenReset()
 for i=1,#value do
  local c=value:sub(i,i)
  if c=='`' then
   screenSelect('number')
   touchDown(0,318,738);msleep(700)
   touchMove(0,149,675);msleep(80);touchUp(0,149,675)
   msleep(math.random(100,500))
  elseif c==' ' then screenSelect('alpha');screenTap(207,795)
  else
   local lower=c:lower();local page=screenKeys.alpha[lower] and 'alpha' or (screenKeys.number[c] and 'number' or 'symbol')
   local key=screenKeys[page][page=='alpha' and lower or c]
   if not key then error('屏幕键盘字符未支持') end
   screenKey(page,key[1],key[2],page=='alpha' and c~=lower)
  end
 end
 screenSelect('alpha')
end
__atl_screen_type=function(value)
 if __atl_screen_context=='email' then
  if not emailType then error('独立邮箱键盘尚未加载') end
  emailType(value)
 else screenType(value) end
 return true
end

-- 美国版注册（开发中）：只适用于已验证的 iPhone 11 414×896 点竖屏。
-- 启动前手动打开 Vinted 美国版空白注册页；请从管理器先派发注册任务。
-- 此版本会点击 Continue；只有在用户确认本次真实测试后才允许运行。
if screenWidth()~=414 or screenHeight()~=896 then error('屏幕尺寸不匹配，停止') end
local function scan() return ocrText() end
local function normalized(t) return (t or ''):lower():gsub('^%s+',''):gsub('%s+$','') end
local function exact(w,blocks)
 local found=nil
 for _,b in ipairs(blocks or scan()) do if normalized(b.text)==w then if found then error('字段标签不唯一') end;found=b end end
 return found
end
local function relativeMatch(expected,y,threshold)
 local best=0
 for _,b in ipairs(scan()) do
  if math.abs((b.y+b.height/2)-y)<45 then
   local text=normalized(b.text)
   local punctuationOK=__atl_screen_context~='email' or emailReadMatches(expected,text,y)
   if punctuationOK then local score=us_zip_ratio(expected:lower(),{text});if score>best then best=score end end
  end
 end
 return best>=threshold
end
local first,initial={},scan()
for _,name in ipairs({'full name','username','email','password','zip code'}) do first[name]=exact(name,initial) end
-- 双表单变体（2026-11-05）：Vinted 有概率下发新表单（Username/Email/Password 三字段+双勾选框，
-- 无 full name / zip code，Continue 按钮同色不同版式）。按首屏标签自动判别，两条路径共用
-- 焦点、输入、条款勾选助手；不认识的表单按旧逻辑校验报错的防线保留。
local isNewForm=(not first['full name']) and (not first['zip code']) and first['username']~=nil and first['email']~=nil and first['password']~=nil
if not isNewForm then
 for _,name in ipairs({'full name','username','email','password','zip code'}) do if not first[name] then error('空白表单未确认') end end
end
local job=getRegistrationJob();if not job or job.password~=nil then error('没有可用的注册任务') end
log('REG_JOB '..job.jobId..(isNewForm and ' [新三字段表单]' or ' [旧五字段表单]'))
local function focusField(b,name)
 tap(b.x+b.width/2,b.y+b.height/2);msleep(600)
 local current=exact(name)
 if not current and name=='username' then current=exact('userame') end
 if not current then error('点击后字段标签未确认：'..name) end
 local y=math.floor(current.y+current.height/2+0.5)
 local c=getColor(16,y)
 if type(c)~='number' then error('字段焦点图色不可用') end
 local r=(c>>16)&255;local g=(c>>8)&255;local blue=c&255
 if not (g>r+35 and blue>r+35 and g>55 and blue>55) then error('字段未获得焦点：'..name) end
 return y
end
local function inputField(name,value,threshold)
 local b=exact(name)
 if not b and name=='username' then
  local candidate=exact('userame')
  if candidate then
   local roi={x=0,y=math.max(0,math.floor(candidate.y-15)),width=180,height=55}
   local hits=findImage('US400_us_label_username.png',0.75,roi);if #hits==1 then b=candidate end
  end
 end
 if not b then error('字段未确认') end
 local y=focusField(b,name);__atl_screen_context=name;inputText(value)
 for _=1,2 do
  msleep(700)
  if relativeMatch(value,y,threshold) then return end
 end
 error('字段核验不明确，停止：'..name)
end
if isNewForm then
 -- 新表单按屏幕自上而下顺序填写：Username → Email → Password
 inputField('username',job.username,0.60)
 inputField('email',job.email,0.60)
else
 inputField('full name',job.fullName,0.60)
 inputField('email',job.email,0.60)
end
local pass=exact('password');if not pass then error('密码栏未确认') end
-- 用户确认全新空白表单的眼睛图标可能随机；只在此页面按密码栏右侧一次。
local eyeX=screenWidth()-48
local eyeY=pass.y+pass.height/2
if eyeY<100 or eyeY>screenHeight()-100 then error('密码栏位置不明确') end
tap(eyeX,eyeY);msleep(700)
focusField(pass,'password');__atl_screen_context='password';inputRegistrationPassword();msleep(700)
tap(eyeX,eyeY);msleep(700)
if not isNewForm then inputField('username',job.username,0.60) end
registrationStage('username_filled')
if isNewForm then
 -- 新表单无 ZIP 字段：滑动收起键盘后条款与按钮已在视野内，直接进入条款确认
 registrationStage('fields_ready')
 swipe(200,530,200,250,450);msleep(1200)
else
 local zip=exact('zip code');if not zip then error('ZIP字段未确认') end
 local zy=focusField(zip,'zip code')
 local keys=us_locate_numeric_keypad(scan(),screenWidth(),screenHeight(),getColor);if not keys then error('数字键盘未确认') end
 for i=1,5 do
  local pt=keys[job.zip:sub(i,i)];if not pt then error('数字键缺失') end
  tap(pt[1],pt[2]);msleep(math.random(100,500))
 end
 local zipConfirmed=false
 for _=1,2 do msleep(700);if relativeMatch(job.zip,zy,0.60) then zipConfirmed=true;break end end
 if not zipConfirmed then error('ZIP核验不明确') end
 registrationStage('fields_ready')
 -- 数字键盘无 Done：在表单区域向上滑动，之后由条款和按钮重新定位复核。
 swipe(200,530,200,250,450);msleep(1200)
end
local function anchor()
 local found=nil
 for _,b in ipairs(scan()) do local t=normalized(b.text):gsub('%s','');if t:find('terms&conditions',1,true) then if found then error('条款标签不唯一') end;found={x=b.x+b.width/2,y=b.y+b.height/2} end end
 return found
end
local function area(a) return {x=0,y=math.max(0,math.floor(a.y-40)),width=80,height=80} end
-- 新旧表单的勾选框尺寸不同（旧60×60、新56×60物理像素），两套模板依次尝试
local function empty(a)
 local h=findImage('US400_calibrated_unchecked.png',0.75,area(a))
 if #h~=1 then h=findImage('US400_reg2_unchecked.png',0.75,area(a)) end
 if #h==1 then return {x=h[1][1],y=h[1][2]} end
end
local function checked(a) local h=findImage('US400_reg_checked.png',0.75,area(a));if #h==1 then return {x=h[1][1],y=h[1][2]} end end
local function classify(q) return us_checkbox_classify(getColor,q.x,q.y,screenWidth(),screenHeight()) end
local state=us_check_terms_once(anchor,empty,checked,classify,function(q) tap(q.x,q.y) end,msleep,3)
if state~='checked' and state~='already_checked' then error('条款未确认') end
for _,b in ipairs(scan()) do
 local text=normalized(b.text)
 for _,phrase in ipairs({'invalid email','invalid password','already in use','already taken','already exists','is required','must contain'}) do
  if text:find(phrase,1,true) then error('表单存在校验提示，停止提交') end
 end
end
-- 新旧表单 Continue 按钮版式不同（旧模板对新按钮 NCC 仅 0.14），两套模板依次尝试；
-- 搜索区上沿扩到 480：新按钮中心在逻辑 y≈546，模板顶会到 508，旧区起点 550 会漏。
local button=findImage('US400_reg_continue.png',0.75,{x=0,y=480,width=414,height=330})
if #button~=1 then button=findImage('US400_reg2_continue.png',0.75,{x=0,y=480,width=414,height=330}) end
if #button~=1 then error('Continue按钮未确认') end
registrationStage('begin_submit');tap(button[1][1],button[1][2]);msleep(600)
local humanSeen=false
for _=1,12 do
 local blocks=scan();local human=false;local field=false
 for _,b in ipairs(blocks) do
  local t=normalized(b.text)
  if t:find('session has been blocked',1,true) then error('SERVER_BLOCKED_STOP') end
  if t:find('account is blocked',1,true) or t:find('blocked your account',1,true) then error('ACCOUNT_BLOCKED_RESULT') end
  if t:find('human',1,true) and t:find('verify',1,true) then human=true end
  if t:find('phone number',1,true) then error('SMS_REQUIRED_RESULT') end
  if t:find('verification code',1,true) or t:find('check your inbox',1,true) then field=true end
 end
 if human then humanSeen=true end
 if field then registrationStage('verification_seen');return end
 msleep(700)
end
if humanSeen then log('HUMAN_VERIFY_SEEN');return end
error('SUBMIT_RESULT_UNKNOWN_STOP')

end
parts['verify']=function()
-- 开发中：基于OCR锚点和多点图色验证数字键盘，只返回候选坐标，不发送触摸。
-- 各次getColor不是同一冻结帧，因此只可作为受控测试，未通过完整真机负例前不接入注册。
local function us_locate_numeric_keypad(blocks, width, height, get_color)
    if type(blocks) ~= 'table' or type(width) ~= 'number' or type(height) ~= 'number' or type(get_color) ~= 'function' then return nil, '参数错误' end
    local a = {}
    for _, b in ipairs(blocks) do
        local t = tostring(b.text or ''):gsub('%s','')
        if t:match('^[1-9]$') and type(b.x)=='number' and type(b.y)=='number' and type(b.width)=='number' and type(b.height)=='number' and b.y > height*0.5 then
            if a[t] then return nil, '数字锚点重复' end
            a[t] = {b.x+b.width/2,b.y+b.height/2}
        end
    end
    local anchors={}
    for d=1,9 do
        local point=a[tostring(d)]
        if point then anchors[#anchors+1]={point[1],point[2],(d-1)%3,math.floor((d-1)/3)} end
    end
    if #anchors<5 then return nil, '数字锚点不足' end
    local dxsum,dysum,dxcount,dycount=0,0,0,0
    for i=1,#anchors do for j=i+1,#anchors do
        local p,q=anchors[i],anchors[j]
        if p[3]~=q[3] then dxsum=dxsum+(q[1]-p[1])/(q[3]-p[3]);dxcount=dxcount+1 end
        if p[4]~=q[4] then dysum=dysum+(q[2]-p[2])/(q[4]-p[4]);dycount=dycount+1 end
    end end
    if dxcount==0 or dycount==0 then return nil, '锚点布局不足' end
    local dx,dy=dxsum/dxcount,dysum/dycount
    if dx<width*0.19 or dx>width*0.40 or dy<height*0.035 or dy>height*0.10 then return nil, '键盘间距不符合' end
    local bx,by=0,0
    for _,p in ipairs(anchors) do bx=bx+p[1]-p[3]*dx;by=by+p[2]-p[4]*dy end
    bx,by=bx/#anchors,by/#anchors
    for _,p in ipairs(anchors) do
        if math.abs(p[1]-(bx+p[3]*dx))>width*0.025 or math.abs(p[2]-(by+p[4]*dy))>height*0.02 then
            return nil, '数字锚点排列不符合'
        end
    end
    local x1,x2,x3=bx,bx+dx,bx+2*dx
    local xs={x1,x2,x3};local ys={by,by+dy,by+2*dy,by+3*dy}
    local offset=dx*0.22
    local function white(x,y)
        x=math.floor(x+0.5);y=math.floor(y+0.5)
        if x<0 or y<0 or x>=width or y>=height then return nil end
        local c=get_color(x,y)
        if type(c)~='number' then return nil end
        local red=(c>>16)&255;local green=(c>>8)&255;local blue=c&255
        return math.min(red,green,blue)>235 and math.max(red,green,blue)-math.min(red,green,blue)<25
    end
    for row=1,4 do
        for col=1,3 do
            local expected=row<4 or col==2
            local left=white(xs[col]-offset,ys[row]+10)
            local right=white(xs[col]+offset,ys[row]+10)
            if left==nil or right==nil or left~=expected or right~=expected then return nil, '按键图色不匹配' end
        end
    end
    for row=1,3 do
        if white((x1+x2)/2,ys[row]+10) ~= false or white((x2+x3)/2,ys[row]+10) ~= false then
            return nil, '列间隔未确认'
        end
    end
    for row=1,3 do
        if white(x2+offset,ys[row]+dy*0.66) ~= false then return nil, '行间隔未确认' end
    end
    local result={}
    for row=1,3 do for col=1,3 do result[tostring((row-1)*3+col)]={xs[col],ys[row]} end end
    result['0']={x2,ys[4]}
    return result
end

-- 与美国版 us_form.zip_match_ratio 的字符匹配规则对应。
-- 输入为ZIP字符串与OCR结果列表；仅在确认ZIP数字字段后使用。
-- 按Unicode码点比较并去除Python str.split()识别的空白。
local function us_is_space(c)
    return (c>=9 and c<=13) or (c>=28 and c<=32) or c==0x85 or c==0xa0 or c==0x1680 or
           (c>=0x2000 and c<=0x200a) or c==0x2028 or c==0x2029 or c==0x202f or c==0x205f or c==0x3000
end
local function us_characters(text, strip_space)
    local result={}
    for _,c in utf8.codes(text) do
        if not strip_space or not us_is_space(c) then result[#result+1]=c end
    end
    return result
end

local function us_longest_block(a, b, alo, ahi, blo, bhi)
    local best_i, best_j, best_len = alo, blo, 0
    local previous = {}
    for i = alo, ahi do
        local current = {}
        for j = blo, bhi do
            if a[i] == b[j] then
                local size = (previous[j - 1] or 0) + 1
                current[j] = size
                if size > best_len then
                    best_i, best_j, best_len = i - size + 1, j - size + 1, size
                end
            end
        end
        previous = current
    end
    return best_i, best_j, best_len
end

local function us_zip_ratio(value, lines)
    local text = us_characters(table.concat(lines or {}, ""), true)
    if #text == 0 then return 0 end
    local expected = us_characters(value, false)
    local stack = {{1, #expected, 1, #text}}
    local matched = 0
    while #stack > 0 do
        local range = table.remove(stack)
        local i, j, size = us_longest_block(expected, text, range[1], range[2], range[3], range[4])
        if size > 0 then
            matched = matched + size
            if range[1] < i and range[3] < j then
                stack[#stack + 1] = {range[1], i - 1, range[3], j - 1}
            end
            if i + size <= range[2] and j + size <= range[4] then
                stack[#stack + 1] = {i + size, range[2], j + size, range[4]}
            end
        end
    end
    return 2 * matched / (#expected + #text)
end

-- 研发预检：只对已被条款模板及几何约束确认的候选点分类；不执行触摸。
-- getColor每次重新截图；动态页面和动画可能改变画面，调用者必须重新定位复核。
local function us_checkbox_classify(get_color,x,y,width,height)
    if type(get_color)~='function' or type(x)~='number' or type(y)~='number' or
       type(width)~='number' or type(height)~='number' then return 'unknown' end
    x=math.floor(x+0.5);y=math.floor(y+0.5)
    if x<13 or y<13 or x+13>=width or y+13>=height then return 'unknown' end
    local function sample(dx,dy)
        local c=get_color(x+dx,y+dy)
        if type(c)~='number' then return nil end
        local r=(c>>16)&255;local g=(c>>8)&255;local b=c&255
        if r>230 and g>230 and b>230 and math.max(r,g,b)-math.min(r,g,b)<25 then return 'white' end
        if g>70 and b>60 and r<100 and g-r>35 and b-r>20 then return 'teal' end
        if math.max(r,g,b)<180 and math.max(r,g,b)-math.min(r,g,b)<35 then return 'dark' end
        return 'other'
    end
    local teal,white=0,0
    for dx=-8,8,4 do for dy=-8,8,4 do
        local c=sample(dx,dy)
        if not c then return 'unknown' end
        if c=='teal' then teal=teal+1 elseif c=='white' then white=white+1 end
    end end
    if teal>=6 and white>=1 then return 'checked' end
    if teal>0 then return 'unknown' end
    for _,p in ipairs({{0,0},{-6,0},{6,0},{0,-6},{0,6}}) do
        if sample(p[1],p[2])~='white' then return 'unknown' end
    end
    for _,p in ipairs({{-12,0},{11,0},{0,-12},{0,11}}) do
        if sample(p[1],p[2])~='dark' then return 'unknown' end
    end
    return 'unchecked'
end

-- 条款状态机的测试组件，不自行读取屏幕或执行输入；所需函数由调用者提供。
-- 每次只允许点击一次；坐标从新条款锚点平移复核，模糊/失败直接停止。
local function us_check_terms_once(anchor,find_empty,find_checked,classify,click,pause,max_checks)
    if type(max_checks)~='number' or max_checks<1 or max_checks>12 or max_checks~=math.floor(max_checks) then
        error('条款核验次数无效',0)
    end
    local a=anchor()
    if not a or type(a.x)~='number' or type(a.y)~='number' then error('未找到条款锚点',0) end
    local empty=find_empty(a)
    local checked=find_checked(a)
    local point=empty or checked
    if not point or type(point.x)~='number' or type(point.y)~='number' or
       point.x>=a.x or math.abs(point.y-a.y)>80 then error('未确认条款左侧复选框',0) end
    local before=classify(point)
    if before=='checked' then return 'already_checked' end
    if before~='unchecked' then error('复选框图色未确认',0) end
    local dx,dy=point.x-a.x,point.y-a.y
    click(point)
    for _=1,max_checks do
        pause(500)
        local current=anchor()
        if not current or type(current.x)~='number' or type(current.y)~='number' then error('点击后条款锚点消失',0) end
        local expected={x=current.x+dx,y=current.y+dy}
        local state=classify(expected)
        if state=='checked' then return 'checked' end
    end
    error('条款点击后未确认勾选；不会再次点击',0)
end


-- iPhone 11 / 414x896，实机邮箱键盘独立映射。
-- 不复用普通键盘的数字/符号页；按键后等待100..500毫秒。
local emailKeys={alpha={},number={},symbol={}}
local function emailRow(page,text,y,x,dx)
 for i=1,#text do emailKeys[page][text:sub(i,i)]={x+(i-1)*dx,y} end
end
emailRow('alpha','qwertyuiop',626,22,41)
emailRow('alpha','asdfghjkl',682,43,41)
emailRow('alpha','zxcvbnm',738,84,41)
emailRow('number','1234567890',626,22,41)
emailRow('symbol','`|{}?%^*/\'',626,22,41)
for _,page in ipairs({'number','symbol'}) do
 emailRow(page,'$!~&=#[]',682,46,46)
 emailRow(page,'._-+',738,101,71)
end
local emailPage='alpha'
local function emailTap(x,y) tap(x,y);msleep(math.random(100,500)) end
local function emailReset()
 local abc=findImage('PHONE_keyboard_abc.png',0.75,{x=0,y=770,width=55,height=50})
 if abc and #abc==1 then emailTap(27,795)
 else
  local numbers=findImage('PHONE_keyboard_123.png',0.75,{x=0,y=770,width=55,height=50})
  if not numbers or #numbers~=1 then error('邮箱键盘未确认') end
 end
 emailPage='alpha'
end
local function emailSelect(page)
 if emailPage==page then return end
 if emailPage=='alpha' then emailTap(27,795);emailPage='number' end
 if page=='alpha' then emailTap(27,795);emailPage='alpha'
 elseif page~=emailPage then emailTap(27,738);emailPage=page end
end
local function emailType(value)
 if screenWidth()~=414 or screenHeight()~=896 then
  error('邮箱键盘映射仅核对过414x896逻辑坐标，已停止输入')
 end
 value=value:lower()
 for i=1,#value do
  local c=value:sub(i,i)
  if c~='@' and c~='.' and not emailKeys.alpha[c] and not emailKeys.number[c] and not emailKeys.symbol[c] then error('邮箱字符没有实机映射') end
 end
 emailReset()
 for i=1,#value do
  local c=value:sub(i,i)
  if c=='@' or c=='.' then emailSelect('alpha');emailTap(c=='@' and 233 or 284,795)
  else
   local page=emailKeys.alpha[c] and 'alpha' or (emailKeys.number[c] and 'number' or 'symbol')
   emailSelect(page);local key=emailKeys[page][c];emailTap(key[1],key[2])
  end
 end
 emailSelect('alpha')
end
local function emailPunctuation(value)
 return value:lower():gsub('%s',''):gsub('[%w]','')
end
local function emailReadMatches(expected,text,y)
 text=(text or ''):lower():gsub('%s','')
 local expectedMarks=emailPunctuation(expected)
 if not text:find('@',1,true) then
  -- Vision sometimes reads the real @ glyph as 'a'. Require its image instead.
  local hits=findImage('PHONE_email_value_at.png',0.75,{x=0,y=math.max(0,y-22),width=screenWidth(),height=44})
  if not hits or #hits~=1 then return false end
  expectedMarks=expectedMarks:gsub('@','')
 end
 return emailPunctuation(text)==expectedMarks and us_zip_ratio(expected:lower(),{text})>=0.60
end

-- iPhone 11 QWERTY 屏幕键盘；只用点击，不发送 HID 键盘事件。
local screenPage='alpha'
local screenKeys={alpha={},number={},symbol={}}
local function row(page,text,y,x,dx)
 for i=1,#text do screenKeys[page][text:sub(i,i)]={x+(i-1)*dx,y} end
end
row('alpha','qwertyuiop',626,22,41)
row('alpha','asdfghjkl',682,43,41)
row('alpha','zxcvbnm',738,84,41)
row('number','1234567890',626,22,41)
row('number','-/:;()$&@"',682,22,41)
row('symbol','[]{}#%^*+=',626,22,41)
row('symbol','_\\|~<>',682,22,41)
for _,page in ipairs({'number','symbol'}) do row(page,'.,?!\'',738,94,56) end
local function screenTap(x,y) tap(x,y);msleep(math.random(100,500)) end
local function screenReset()
 local abc=findImage('PHONE_keyboard_abc.png',0.75,{x=0,y=770,width=55,height=50})
 if abc and #abc==1 then screenTap(27,795)
 else
  local numbers=findImage('PHONE_keyboard_123.png',0.75,{x=0,y=770,width=55,height=50})
  if not numbers or #numbers~=1 then error('屏幕键盘布局未确认') end
 end
 screenPage='alpha'
end
local function screenSelect(page)
 if screenPage==page then return end
 if screenPage=='alpha' then screenTap(27,795);screenPage='number' end
 if page=='alpha' then screenTap(27,795);screenPage='alpha'
 elseif page~=screenPage then screenTap(27,738);screenPage=page end
end
local function screenKey(page,x,y,upper)
 screenSelect(page)
 if page=='alpha' then
  local color=getColor(15,721)
  if not color then error('Shift 状态不可读') end
  local active=math.min((color>>16)&255,(color>>8)&255,color&255)>225
  if active~=upper then screenTap(27,738) end
 end
 screenTap(x,y)
end
local function screenType(value)
 if value:match('^%d+$') and us_locate_numeric_keypad then
  local keys=us_locate_numeric_keypad(ocrText(),screenWidth(),screenHeight(),getColor)
  if keys then
   for i=1,#value do local key=keys[value:sub(i,i)];screenTap(key[1],key[2]) end
   return
  end
 end
 screenReset()
 for i=1,#value do
  local c=value:sub(i,i)
  if c=='`' then
   screenSelect('number')
   touchDown(0,318,738);msleep(700)
   touchMove(0,149,675);msleep(80);touchUp(0,149,675)
   msleep(math.random(100,500))
  elseif c==' ' then screenSelect('alpha');screenTap(207,795)
  else
   local lower=c:lower();local page=screenKeys.alpha[lower] and 'alpha' or (screenKeys.number[c] and 'number' or 'symbol')
   local key=screenKeys[page][page=='alpha' and lower or c]
   if not key then error('屏幕键盘字符未支持') end
   screenKey(page,key[1],key[2],page=='alpha' and c~=lower)
  end
 end
 screenSelect('alpha')
end
__atl_screen_type=function(value)
 if __atl_screen_context=='email' then
  if not emailType then error('独立邮箱键盘尚未加载') end
  emailType(value)
 else screenType(value) end
 return true
end

