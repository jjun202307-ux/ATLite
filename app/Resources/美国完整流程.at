  local labels=findText(label);local selected=nil
  for _,p in ipairs(labels or {}) do if p[2]>100 and p[2]<800 and (not selected or p[2]>selected[2]) then selected=p end end
  if not selected then error('APP_LABEL_NOT_FOUND '..label) end
  hits=findImage('PHONE_launch_'..icon..'.png',0.75,{x=math.max(0,math.min(316,selected[1]-49)),y=math.max(0,selected[2]-90),width=98,height=88})
 end
 if not hits or #hits~=1 then error('APP_ICON_NOT_FOUND '..label) end
 tap(hits[1][1],hits[1][2]);msleep(1000)
end
